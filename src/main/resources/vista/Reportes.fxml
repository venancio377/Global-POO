<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="900.0" prefHeight="600.0" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.utng.inventario.controlador.ReportesController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="encabezado">
            <padding>
                <Insets top="14.0" right="24.0" bottom="14.0" left="24.0"/>
            </padding>
            <Label text="Reportes de inventario" styleClass="titulo-encabezado"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Exportar a CSV" onAction="#accionExportar" styleClass="boton-secundario"/>
            <Button text="← Volver" onAction="#accionVolver" styleClass="boton-secundario"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="16.0">
            <padding>
                <Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/>
            </padding>
            <HBox spacing="16.0">
                <VBox styleClass="indicador" HBox.hgrow="ALWAYS">
                    <Label text="Artículos registrados" styleClass="indicador-titulo"/>
                    <Label fx:id="lblTotal" styleClass="indicador-valor"/>
                </VBox>
                <VBox styleClass="indicador" HBox.hgrow="ALWAYS">
                    <Label text="Valor del inventario" styleClass="indicador-titulo"/>
                    <Label fx:id="lblValor" styleClass="indicador-valor"/>
                </VBox>
                <VBox styleClass="indicador" HBox.hgrow="ALWAYS">
                    <Label text="Consumibles por reabastecer" styleClass="indicador-titulo"/>
                    <Label fx:id="lblStockBajo" styleClass="indicador-valor"/>
                </VBox>
                <VBox styleClass="indicador" HBox.hgrow="ALWAYS">
                    <Label text="Préstamos activos" styleClass="indicador-titulo"/>
                    <Label fx:id="lblPrestamos" styleClass="indicador-valor"/>
                </VBox>
            </HBox>
            <Label text="Consumibles con stock bajo o agotados" styleClass="titulo-panel"/>
            <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colCodigo" text="Código" prefWidth="90.0"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="260.0"/>
                    <TableColumn fx:id="colCantidad" text="Existencia" prefWidth="90.0"/>
                    <TableColumn fx:id="colMinimo" text="Stock mínimo" prefWidth="100.0"/>
                    <TableColumn fx:id="colArea" text="Área" prefWidth="190.0"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="100.0"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
