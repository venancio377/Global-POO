<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>

<BorderPane prefWidth="980.0" prefHeight="440.0" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.utng.inventario.controlador.PrincipalController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="encabezado">
            <padding>
                <Insets top="16.0" right="24.0" bottom="16.0" left="24.0"/>
            </padding>
            <Label text="Inventario UTNG" styleClass="titulo-encabezado"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblUsuario" styleClass="usuario-encabezado"/>
            <Button text="Cerrar sesión" onAction="#cerrarSesion" styleClass="boton-secundario"/>
        </HBox>
    </top>
    <center>
        <TilePane alignment="CENTER" hgap="24.0" vgap="24.0" prefColumns="4">
            <padding>
                <Insets top="40.0" right="40.0" bottom="40.0" left="40.0"/>
            </padding>
            <Button text="Catálogo&#10;de artículos" onAction="#abrirCatalogo" styleClass="tarjeta-menu"/>
            <Button text="Préstamos&#10;y devoluciones" onAction="#abrirPrestamos" styleClass="tarjeta-menu"/>
            <Button text="Reportes&#10;de inventario" onAction="#abrirReportes" styleClass="tarjeta-menu"/>
            <Button fx:id="btnUsuarios" text="Usuarios&#10;y accesos" onAction="#abrirUsuarios" styleClass="tarjeta-menu"/>
        </TilePane>
    </center>
</BorderPane>
