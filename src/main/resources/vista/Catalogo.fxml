<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="1520.0" prefHeight="660.0" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.utng.inventario.controlador.CatalogoController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="encabezado">
            <padding>
                <Insets top="14.0" right="24.0" bottom="14.0" left="24.0"/>
            </padding>
            <Label text="Catálogo de artículos" styleClass="titulo-encabezado"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Volver" onAction="#accionVolver" styleClass="boton-secundario"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="10.0">
            <padding>
                <Insets top="16.0" right="12.0" bottom="16.0" left="20.0"/>
            </padding>
            <HBox spacing="8.0" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscar" promptText="Buscar por código, nombre, área o responsable"
                           styleClass="campo" HBox.hgrow="ALWAYS" onAction="#accionBuscar"/>
                <Button text="Buscar" onAction="#accionBuscar" styleClass="boton-primario"/>
            </HBox>
            <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCodigo" text="Código" prefWidth="80.0"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="240.0"/>
                    <TableColumn fx:id="colTipo" text="Tipo" prefWidth="150.0"/>
                    <TableColumn fx:id="colCantidad" text="Cant." prefWidth="60.0"/>
                    <TableColumn fx:id="colArea" text="Área" prefWidth="170.0"/>
                    <TableColumn fx:id="colResponsable" text="Responsable" prefWidth="195.0"/>
                    <TableColumn fx:id="colPrecio" text="P. unitario" prefWidth="90.0"/>
                    <TableColumn fx:id="colValor" text="Valor total" prefWidth="100.0"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="100.0"/>
                </columns>
            </TableView>
            <Label fx:id="lblResumen" styleClass="resumen"/>
        </VBox>
    </center>
    <right>
        <VBox spacing="8.0" prefWidth="290.0" styleClass="panel-formulario">
            <padding>
                <Insets top="16.0" right="18.0" bottom="16.0" left="18.0"/>
            </padding>
            <Label text="Datos del artículo" styleClass="titulo-panel"/>
            <Label text="Código"/>
            <TextField fx:id="txtCodigo" styleClass="campo"/>
            <Label text="Nombre"/>
            <TextField fx:id="txtNombre" styleClass="campo"/>
            <Label text="Descripción"/>
            <TextArea fx:id="txtDescripcion" prefRowCount="2" wrapText="true"/>
            <Label text="Tipo"/>
            <ComboBox fx:id="cmbTipo" maxWidth="Infinity"/>
            <HBox spacing="8.0">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="Cantidad"/>
                    <TextField fx:id="txtCantidad" styleClass="campo"/>
                </VBox>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="Stock mínimo"/>
                    <TextField fx:id="txtStockMinimo" styleClass="campo"/>
                </VBox>
            </HBox>
            <Label text="Precio unitario"/>
            <TextField fx:id="txtPrecio" styleClass="campo"/>
            <Label text="Área"/>
            <ComboBox fx:id="cmbArea" maxWidth="Infinity"/>
            <Label text="Responsable"/>
            <ComboBox fx:id="cmbResponsable" maxWidth="Infinity"/>
            <HBox spacing="8.0">
                <Button text="Guardar nuevo" onAction="#accionGuardar" styleClass="boton-primario" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Actualizar" onAction="#accionActualizar" styleClass="boton-primario" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
            <HBox spacing="8.0">
                <Button fx:id="btnEliminar" text="Eliminar" onAction="#accionEliminar" styleClass="boton-peligro" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Limpiar" onAction="#accionLimpiar" styleClass="boton-secundario-oscuro" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
        </VBox>
    </right>
</BorderPane>
