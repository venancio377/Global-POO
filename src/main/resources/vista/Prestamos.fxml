<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="1060.0" prefHeight="620.0" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.utng.inventario.controlador.PrestamosController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="encabezado">
            <padding>
                <Insets top="14.0" right="24.0" bottom="14.0" left="24.0"/>
            </padding>
            <Label text="Préstamos y devoluciones" styleClass="titulo-encabezado"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Volver" onAction="#accionVolver" styleClass="boton-secundario"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="12.0">
            <padding>
                <Insets top="16.0" right="24.0" bottom="16.0" left="24.0"/>
            </padding>
            <HBox spacing="10.0" alignment="BOTTOM_LEFT" styleClass="panel-formulario">
                <padding>
                    <Insets top="12.0" right="12.0" bottom="12.0" left="12.0"/>
                </padding>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="Artículo"/>
                    <ComboBox fx:id="cmbArticulo" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="Responsable"/>
                    <ComboBox fx:id="cmbResponsable" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="4.0" prefWidth="90.0">
                    <Label text="Cantidad"/>
                    <TextField fx:id="txtCantidad" styleClass="campo"/>
                </VBox>
                <Button text="Registrar préstamo" minWidth="-Infinity" onAction="#accionPrestar" styleClass="boton-primario"/>
                <Button text="Registrar devolución" minWidth="-Infinity" onAction="#accionDevolver" styleClass="boton-secundario-oscuro"/>
            </HBox>
            <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId" text="#" prefWidth="50.0"/>
                    <TableColumn fx:id="colArticulo" text="Artículo" prefWidth="200.0"/>
                    <TableColumn fx:id="colResponsable" text="Responsable" prefWidth="180.0"/>
                    <TableColumn fx:id="colCantidad" text="Cant." prefWidth="60.0"/>
                    <TableColumn fx:id="colPrestamo" text="Fecha préstamo" prefWidth="140.0"/>
                    <TableColumn fx:id="colDevolucion" text="Fecha devolución" prefWidth="140.0"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="90.0"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
