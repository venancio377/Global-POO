<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="960.0" prefHeight="560.0" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.utng.inventario.controlador.UsuariosController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="encabezado">
            <padding>
                <Insets top="14.0" right="24.0" bottom="14.0" left="24.0"/>
            </padding>
            <Label text="Usuarios y accesos" styleClass="titulo-encabezado"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="← Volver" onAction="#accionVolver" styleClass="boton-secundario"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="10.0">
            <padding>
                <Insets top="16.0" right="12.0" bottom="16.0" left="20.0"/>
            </padding>
            <Label text="Cuentas registradas" styleClass="titulo-panel"/>
            <TableView fx:id="tabla" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colUsuario" text="Usuario" prefWidth="140.0"/>
                    <TableColumn fx:id="colNombre" text="Nombre completo" prefWidth="260.0"/>
                    <TableColumn fx:id="colRol" text="Rol" prefWidth="100.0"/>
                </columns>
            </TableView>
            <Label fx:id="lblSeleccion" styleClass="resumen" wrapText="true"/>
        </VBox>
    </center>
    <right>
        <VBox spacing="8.0" prefWidth="310.0" styleClass="panel-formulario">
            <padding>
                <Insets top="16.0" right="18.0" bottom="16.0" left="18.0"/>
            </padding>
            <Label text="Nuevo técnico" styleClass="titulo-panel"/>
            <Label text="Usuario"/>
            <TextField fx:id="txtUsuario" styleClass="campo"/>
            <Label text="Nombre completo"/>
            <TextField fx:id="txtNombre" styleClass="campo"/>
            <Label text="Contraseña (mínimo 6 caracteres)"/>
            <PasswordField fx:id="txtPassword" styleClass="campo"/>
            <Label text="Confirmar contraseña"/>
            <PasswordField fx:id="txtConfirmar" styleClass="campo"/>
            <Button text="Agregar técnico" onAction="#accionAgregar" styleClass="boton-primario" maxWidth="Infinity"/>
            <Button fx:id="btnCambiar" text="Cambiar contraseña del seleccionado" onAction="#accionCambiarPassword"
                    styleClass="boton-primario" maxWidth="Infinity"/>
            <HBox spacing="8.0">
                <Button fx:id="btnEliminar" text="Eliminar" onAction="#accionEliminar" styleClass="boton-peligro" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Limpiar" onAction="#accionLimpiar" styleClass="boton-secundario-oscuro" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
        </VBox>
    </right>
</BorderPane>
